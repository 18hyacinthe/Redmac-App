{
    "cli": {
        "version": ">= 3.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "preview": {
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
            }
        }
    }
}